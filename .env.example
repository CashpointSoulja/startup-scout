# AI Gateway: no key needed locally. `vercel env pull .env.local` adds VERCEL_OIDC_TOKEN.
# Or set an AI Gateway API key instead:
# AI_GATEWAY_API_KEY=

# Vercel Blob is only used on deployments (connected automatically by `vercel blob create-store`).
# BLOB_READ_WRITE_TOKEN=

# Name the drafts are signed with (default: Ayo)
# SENDER_NAME=
